# Eurasan OpenClaw Integration - Environment Variables

# Eurasan credentials
EURASAN_USERNAME=your_username_here
EURASAN_PASSWORD=your_password_here

# API Configuration
EURASAN_API_URL=https://api.eurasan.com
EURASAN_WEB_URL=https://www.eurasan.com

# OpenClaw Configuration
OPENCLAW_RUNTIME_URL=http://localhost:8080
OPENCLAW_BROWSER_HEADLESS=true

# Session Configuration
EURASAN_SESSION_TIMEOUT=3600
EURASAN_MFA_SECRET=your_mfa_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/eurasan.log